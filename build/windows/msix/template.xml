<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="claude-sessions"
        Arguments=""
        InstallLocation="C:\Program Files\AlBannaTechno\Claude Sessions">
    </Installer>
    <PackageInformation
        PackageName="Claude Sessions"
        PackageDisplayName="Claude Sessions"
        PublisherName="CN=AlBannaTechno"
        PublisherDisplayName="AlBannaTechno"
        Version="0.1.0.0"
        PackageDescription="Watches GitHub pull requests and runs Claude Code reviews">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.albannatechno.claudesessions"
                Description="Watches GitHub pull requests and runs Claude Code reviews"
                DisplayName="Claude Sessions"
                ExecutableName="claude-sessions"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Claude Sessions</DisplayName>
            <PublisherDisplayName>AlBannaTechno</PublisherDisplayName>
            <Description>Watches GitHub pull requests and runs Claude Code reviews</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="claude-sessions.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
